module

public import LeanInets.Glue
public import Mathlib.Logic.Relation
public import Mathlib.Data.Fintype.EquivFin
public import Mathlib.Data.Fintype.Option

/-!
# Connected ports

Two ports are *adjacent* if they are linked, or if they are the two ends of a wire, and
*connected* (`Net.Connected`) if they are related by the equivalence relation generated by
adjacency. Every port is adjacent to its link partner, and the end of a wire also to the
other end of the wire, so the classes of `Connected` are disjoint paths and cycles:

* a path consists of two *terminal* ports (free ports or agent ports) with any number of
  wire ends in between;
* a cycle consists of wire ends only (a vicious circle).

To work with paths we walk along them: starting at a terminal port `x`, follow its link, and
whenever this reaches an end of a wire, pass through the wire (`Step`) and follow the link of
its other end. This always ends at another terminal port, the *partner* of `x`
(`Net.Partner`). Two terminal ports are connected iff they are equal or partners
(`connected_tport_iff`).

Connections are what matters about a net: two nets that differ only in their wires (chains
of wires, the orientation of wires, closed loops of wires) have the same connections.
-/

@[expose] public section

namespace Net

variable {S : Signature} {ι : Type} (N : Net S ι)

/-! ### Terminal ports -/

/-- The terminal ports of `N`: its free ports and agent ports. -/
abbrev TPort := _root_.Port N.label Empty ι

/-- A terminal port as a port of `N`. -/
def tport (x : N.TPort) : N.Port := x.map id (fun _ => rfl) Empty.elim id

variable {N}

@[simp] theorem tport_free (i : ι) : N.tport (.free i) = .free i := rfl
@[simp] theorem tport_pri (a : N.Agent) : N.tport (.pri a) = .pri a := rfl
@[simp] theorem tport_aux (a : N.Agent) (k) : N.tport (.aux a k) = .aux a k := rfl

theorem tport_injective : Function.Injective N.tport :=
  Port.map_injective id (fun _ => rfl) Empty.elim id Function.injective_id (fun a => a.elim)
    Function.injective_id

theorem tport_ne_wire (x : N.TPort) (w : N.Wire) (s : Side) : N.tport x ≠ .wire w s := by
  rcases x with _ | _ | _ | ⟨⟨⟩, _⟩ <;> nofun

/-- Every port that is not the end of a wire is terminal. -/
theorem exists_tport (p : N.Port) (h : ∀ w s, p ≠ .wire w s) : ∃ x, p = N.tport x := by
  rcases p with i | a | ⟨a, k⟩ | ⟨w, s⟩
  · exact ⟨.free i, rfl⟩
  · exact ⟨.pri a, rfl⟩
  · exact ⟨.aux a k, rfl⟩
  · exact absurd rfl (h w s)

/-! ### Passing through wires -/

variable (N) in
/-- Passing through a wire: from one end of a wire to the port linked to its other end. -/
def Step : N.Port → N.Port → Prop
  | .free _, _ => False
  | .pri _, _ => False
  | .aux _ _, _ => False
  | .wire w s, q => q = N.link (.wire w s.flip)

theorem step_wire (w : N.Wire) (s : Side) : N.Step (.wire w s) (N.link (.wire w s.flip)) := rfl

theorem Step.eq {p q : N.Port} (h : N.Step p q) :
    ∃ w s, p = .wire w s ∧ q = N.link (.wire w s.flip) := by
  cases p with
  | wire w s => exact ⟨w, s, rfl, h⟩
  | _ => exact h.elim

theorem not_step_tport (x : N.TPort) (q : N.Port) : ¬ N.Step (N.tport x) q := fun h => by
  obtain ⟨w, s, h, -⟩ := h.eq
  exact tport_ne_wire x w s h

theorem step_rightUnique : Relator.RightUnique N.Step := fun p q q' h h' => by
  obtain ⟨w, s, rfl, rfl⟩ := h.eq
  exact h'.symm

/-- Passing through a wire, backwards. -/
theorem Step.reverse {p q : N.Port} (h : N.Step p q) : N.Step (N.link q) (N.link p) := by
  obtain ⟨w, s, rfl, rfl⟩ := h.eq
  rw [N.link_link]
  show _ = N.link (.wire w s.flip.flip)
  rw [Side.flip_flip]

theorem reflTransGen_step_reverse {p q : N.Port} (h : Relation.ReflTransGen N.Step p q) :
    Relation.ReflTransGen N.Step (N.link q) (N.link p) := by
  induction h with
  | refl => rfl
  | tail _ hbc ih => exact ih.head hbc.reverse

/-! ### Partners -/

variable (N) in
/-- `y` is the partner of `x`: following the link of `x` and passing through wires leads to
`y`. -/
def Partner (x y : N.TPort) : Prop :=
  Relation.ReflTransGen N.Step (N.link (N.tport x)) (N.tport y)

theorem Partner.symm {x y : N.TPort} (h : N.Partner x y) : N.Partner y x := by
  have := reflTransGen_step_reverse h
  rwa [N.link_link] at this

/-- Each terminal port is connected to at most one terminal port. -/
theorem Partner.unique {x y z : N.TPort} (hy : N.Partner x y) (hz : N.Partner x z) : y = z := by
  have stuck {u v : N.TPort} (h : Relation.ReflTransGen N.Step (N.tport u) (N.tport v)) :
      u = v := by
    rcases h.cases_head with h | ⟨c, hc, -⟩
    · exact tport_injective h
    · exact absurd hc (not_step_tport u c)
  rcases Relation.ReflTransGen.total_of_right_unique step_rightUnique hy hz with h | h
  exacts [stuck h, (stuck h).symm]

/-- The partner of a wire end after passing through its wire. -/
def throughWire : N.Port → N.Port
  | .wire w s => N.link (.wire w s.flip)
  | p => p

/-- The wire end of a port, if it is one. -/
def wireEnd : N.Port → Option (N.Wire × Side)
  | .wire w s => some (w, s)
  | _ => none

/-- Each terminal port is connected to some terminal port: the walk through wires cannot go
on forever, since it never visits a wire end twice. -/
theorem Partner.exists (x : N.TPort) : ∃ y, N.Partner x y := by
  by_contra hne
  set a := N.link (N.tport x)
  have wireEnd_of_reach {p} (hp : Relation.ReflTransGen N.Step a p) : ∃ w s, p = .wire w s := by
    by_contra h
    obtain ⟨y, rfl⟩ := exists_tport p fun w s e => h ⟨w, s, e⟩
    exact hne ⟨y, hp⟩
  -- The walk `a, throughWire a, throughWire (throughWire a), ...` only visits wire ends.
  have reach (n : ℕ) : Relation.ReflTransGen N.Step a (throughWire^[n] a) := by
    induction n with
    | zero => rfl
    | succ n ih =>
      obtain ⟨w, s, hw⟩ := wireEnd_of_reach ih
      rw [Function.iterate_succ_apply']
      refine ih.tail ?_
      rw [hw]
      exact step_wire w s
  -- It never revisits a wire end.
  have ne (i j : ℕ) (hij : i < j) : throughWire^[i] a ≠ throughWire^[j] a := by
    induction i generalizing j with
    | zero =>
      obtain ⟨j, rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      obtain ⟨w, s, hw⟩ := wireEnd_of_reach (reach j)
      rw [Function.iterate_succ_apply', hw]
      intro h
      exact tport_ne_wire x w s.flip (N.link_injective h)
    | succ i ih =>
      obtain ⟨j, rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      obtain ⟨w, s, hw⟩ := wireEnd_of_reach (reach i)
      obtain ⟨w', s', hw'⟩ := wireEnd_of_reach (reach j)
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', hw, hw']
      intro h
      have h := N.link_injective h
      simp only [Port.wire.injEq] at h
      apply ih j (by omega)
      rw [hw, hw', h.1, (by simpa using congrArg Side.flip h.2 : s = s')]
  have inj : Function.Injective fun n => wireEnd (throughWire^[n] a) := by
    intro i j h
    by_contra hij
    obtain ⟨w, s, hw⟩ := wireEnd_of_reach (reach i)
    obtain ⟨w', s', hw'⟩ := wireEnd_of_reach (reach j)
    simp only [hw, hw', wireEnd, Option.some.injEq, Prod.mk.injEq] at h
    rcases Nat.lt_or_gt_of_ne hij with hlt | hlt
    · exact ne i j hlt (by rw [hw, hw', h.1, h.2])
    · exact ne j i hlt (by rw [hw, hw', h.1, h.2])
  exact not_injective_infinite_finite _ inj

/-- Walks are preserved by maps of ports that pass through wires. -/
theorem reflTransGen_map {ι' : Type} {M : Net S ι'} (f : N.Port → M.Port)
    (hf : ∀ p q, N.Step p q → M.Step (f p) (f q)) {p q : N.Port}
    (h : Relation.ReflTransGen N.Step p q) : Relation.ReflTransGen M.Step (f p) (f q) :=
  Relation.ReflTransGen.lift f hf p q h

/-- An injective map of terminal ports that maps partners to partners also reflects them. -/
theorem partner_reflect {ι' : Type} {M : Net S ι'} (f : N.TPort → M.TPort)
    (hf : Function.Injective f) (h : ∀ x y, N.Partner x y → M.Partner (f x) (f y))
    {x y : N.TPort} (hxy : M.Partner (f x) (f y)) : N.Partner x y := by
  obtain ⟨z, hz⟩ := Partner.exists x
  rwa [hf (hxy.unique (h x z hz))]

/-! ### Connected ports -/

/-- The other end of a wire. Terminal ports are left unchanged. -/
def flipEnd : N.Port → N.Port
  | .free i => .free i
  | .pri a => .pri a
  | .aux a k => .aux a k
  | .wire w s => .wire w s.flip

@[simp] theorem flipEnd_flipEnd (p : N.Port) : flipEnd (flipEnd p) = p := by
  cases p <;> simp [flipEnd]

theorem flipEnd_tport (x : N.TPort) : flipEnd (N.tport x) = N.tport x := by
  rcases x with _ | _ | _ | ⟨⟨⟩, _⟩ <;> rfl

theorem eq_of_flipEnd_eq_tport {p : N.Port} {x : N.TPort} (h : flipEnd p = N.tport x) :
    p = N.tport x := by
  cases p with
  | wire w s => exact absurd h.symm (tport_ne_wire x w s.flip)
  | _ => exact h

variable (N) in
/-- Two ports are adjacent if they are linked, or if they are the two ends of a wire. -/
def Adjacent (p q : N.Port) : Prop := q = N.link p ∨ q = flipEnd p

theorem Adjacent.symm {p q : N.Port} (h : N.Adjacent p q) : N.Adjacent q p := by
  rcases h with rfl | rfl
  · exact .inl (N.link_link p).symm
  · exact .inr (flipEnd_flipEnd p).symm

variable (N) in
/-- Two ports are connected if they lie on the same path (or cycle) of links and wires. -/
def Connected : N.Port → N.Port → Prop := Relation.EqvGen N.Adjacent

theorem connected_equivalence : Equivalence N.Connected := Relation.EqvGen.is_equivalence _

@[refl] theorem Connected.refl (p : N.Port) : N.Connected p p := Relation.EqvGen.refl p

@[symm] theorem Connected.symm {p q : N.Port} (h : N.Connected p q) : N.Connected q p :=
  Relation.EqvGen.symm _ _ h

@[trans] theorem Connected.trans {p q r : N.Port} (h : N.Connected p q)
    (h' : N.Connected q r) : N.Connected p r :=
  Relation.EqvGen.trans _ _ _ h h'

theorem connected_link (p : N.Port) : N.Connected p (N.link p) := .rel _ _ (.inl rfl)

theorem connected_flipEnd (p : N.Port) : N.Connected p (flipEnd p) := .rel _ _ (.inr rfl)

theorem Step.connected {p q : N.Port} (h : N.Step p q) : N.Connected p q := by
  obtain ⟨w, s, rfl, rfl⟩ := h.eq
  exact (connected_flipEnd _).trans (connected_link (.wire w s.flip))

theorem connected_of_reflTransGen {p q : N.Port} (h : Relation.ReflTransGen N.Step p q) :
    N.Connected p q := by
  induction h with
  | refl => rfl
  | tail _ h ih => exact ih.trans h.connected

theorem Partner.connected {x y : N.TPort} (h : N.Partner x y) :
    N.Connected (N.tport x) (N.tport y) :=
  (connected_link _).trans (connected_of_reflTransGen h)

variable (N) in
/-- The port `p` lies on the path starting at the terminal port `y`: it is `y`, a port
reached from `y` by walking, or the other end of a wire end reached from `y`. -/
def OnPath (y : N.TPort) (p : N.Port) : Prop :=
  p = N.tport y ∨ Relation.ReflTransGen N.Step (N.link (N.tport y)) p ∨
    ∃ a, Relation.ReflTransGen N.Step (N.link (N.tport y)) a ∧ p = flipEnd a

theorem OnPath.link_of_reach {y : N.TPort} {p : N.Port}
    (h : Relation.ReflTransGen N.Step (N.link (N.tport y)) p) : N.OnPath y (N.link p) := by
  rcases h.cases_tail with rfl | ⟨c, hc, hcp⟩
  · exact .inl (N.link_link _)
  · obtain ⟨w, s, rfl, rfl⟩ := hcp.eq
    exact .inr (.inr ⟨_, hc, by rw [N.link_link]; rfl⟩)

theorem OnPath.link {y : N.TPort} {p : N.Port} (h : N.OnPath y p) : N.OnPath y (N.link p) := by
  rcases h with rfl | h | ⟨a, ha, rfl⟩
  · exact .inr (.inl .refl)
  · exact link_of_reach h
  · cases a with
    | wire w s => exact .inr (.inl (ha.tail (step_wire w s)))
    | _ => exact link_of_reach ha

theorem OnPath.flipEnd {y : N.TPort} {p : N.Port} (h : N.OnPath y p) :
    N.OnPath y (flipEnd p) := by
  rcases h with rfl | h | ⟨a, ha, rfl⟩
  · exact .inl (flipEnd_tport y)
  · exact .inr (.inr ⟨p, h, rfl⟩)
  · rw [flipEnd_flipEnd]
    exact .inr (.inl ha)

theorem OnPath.adjacent {y : N.TPort} {p q : N.Port} (h : N.OnPath y p)
    (hpq : N.Adjacent p q) : N.OnPath y q := by
  rcases hpq with rfl | rfl
  exacts [h.link, h.flipEnd]

/-- Lying on the path starting at `y` is invariant under connectedness. -/
theorem Connected.onPath_iff {p q : N.Port} (h : N.Connected p q) (y : N.TPort) :
    N.OnPath y p ↔ N.OnPath y q := by
  induction h with
  | rel _ _ h => exact ⟨fun hp => hp.adjacent h, fun hq => hq.adjacent h.symm⟩
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

/-- Two terminal ports are connected iff they are equal or partners. In particular, a path
contains exactly two terminal ports. -/
theorem connected_tport_iff {x y : N.TPort} :
    N.Connected (N.tport x) (N.tport y) ↔ x = y ∨ N.Partner x y := by
  refine ⟨fun h => ?_, ?_⟩
  · rcases (h.onPath_iff y).mpr (.inl rfl) with h | h | ⟨a, ha, h⟩
    · exact .inl (tport_injective h)
    · exact .inr (Partner.symm h)
    · rw [eq_of_flipEnd_eq_tport h.symm] at ha
      exact .inr (Partner.symm ha)
  · rintro (rfl | h)
    exacts [.refl _, h.connected]

end Net
